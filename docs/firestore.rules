rules_version = '2';
// Règles Firestore de la Pointeuse LPF = règles en production + ajouts pour la planification automatique
// (règle 1 : lecture réservée aux comptes validés, « affinites » et « chats » exclus de la lecture générale ; règle 2 : skillsAdmin et superAdmin protégés ; règle 9 : affinites).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    // Compte validé par l'admin (un compte créé librement reste « pending » ; « banned » = plus aucun accès)
    function isApproved() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // 1. LECTURE : comptes validés seulement. « affinites » (9), la messagerie (3) et « users » (2) ont leurs propres règles :
    //    sinon cette règle générale (les règles s'additionnent) laisserait lire les messages ou les jetons des autres.
    match /{collection}/{document=**} {
      allow read: if isApproved() && !(collection in ['affinites', 'chats', 'users']);
    }

    // 2. UTILISATEURS : impossible de changer soi-même son rôle, son statut, les notes de l'admin ou le statut super admin
    match /users/{userId} {
      // Sa propre fiche reste lisible en attente de validation (écran « compte en attente »)
      allow read: if isOwner(userId) || isApproved();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isOwner(userId)
                    && request.resource.data.get('role', null) == resource.data.get('role', null)
                    && request.resource.data.get('status', null) == resource.data.get('status', null)
                    && request.resource.data.get('skillsAdmin', null) == resource.data.get('skillsAdmin', null)
                    && request.resource.data.get('superAdmin', null) == resource.data.get('superAdmin', null));
      allow delete: if isAdmin();

      // Jetons de notification : chacun gère seulement ceux de ses appareils ; le serveur (admin SDK) lit les autres
      match /pushTokens/{token} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.keys().hasOnly(['platform', 'createdAt', 'lastSeen'])
                              && request.resource.data.platform in ['android', 'ios', 'desktop'];
      }
    }

    // 3. MESSAGERIE : discussions à deux et groupes, réservées à leurs membres.
    //    Seuls les admins d'un groupe changent ses membres ; chacun peut le quitter.
    match /chats/{chatId} {
      function members() { return resource.data.participants; }
      function sameMembers() {
        return request.resource.data.participants == resource.data.participants
            && request.resource.data.get('admins', []) == resource.data.get('admins', [])
            && request.resource.data.get('name', null) == resource.data.get('name', null);
      }
      function groupAdmin() { return request.auth.uid in resource.data.get('admins', []); }
      // Quitter : seul soi-même disparaît des membres (et des admins), personne n'est ajouté
      function leaving() {
        return resource.data.get('type', 'direct') == 'group'
            && resource.data.participants.toSet().difference(request.resource.data.participants.toSet()) == [request.auth.uid].toSet()
            && request.resource.data.participants.toSet().difference(resource.data.participants.toSet()).size() == 0
            && request.resource.data.get('admins', []).toSet().difference(resource.data.get('admins', []).toSet()).size() == 0;
      }
      allow read: if isApproved() && request.auth.uid in members();
      allow create: if isApproved() && request.auth.uid in request.resource.data.participants
                    && (request.resource.data.get('type', 'direct') != 'group'
                        || (request.resource.data.createdBy == request.auth.uid && request.resource.data.admins == [request.auth.uid]));
      allow update: if isApproved() && request.auth.uid in members() && (sameMembers() || groupAdmin() || leaving());

      match /messages/{messageId} {
        function chatMember() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isApproved() && chatMember();
        allow create: if isApproved() && chatMember() && request.resource.data.senderId == request.auth.uid;
        // Modifier ou supprimer : l'auteur seulement ; réagir (👍…) : tout membre
        allow update: if isApproved() && chatMember() && (
                         (resource.data.senderId == request.auth.uid && request.resource.data.senderId == request.auth.uid)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      }
    }

    // 4. POINTAGES : chacun crée et modifie uniquement les siens
    match /pointages/{docId} {
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
      match /auditLog/{logId} { allow write: if isAdmin(); }
    }

    // 4b. TRAJETS : chacun crée, recalcule et supprime uniquement les siens
    match /trajets/{docId} {
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.id_utilisateur == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated()
                    && resource.data.id_utilisateur == request.auth.uid
                    && request.resource.data.id_utilisateur == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.id_utilisateur == request.auth.uid);
    }

    // 5. CONGÉS : l'employé peut annuler sa propre demande
    match /leaveRequests/{requestId} {
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 6. PLANNING : l'admin gère tout ; l'employé ajoute/retire ses propres chantiers
    //    et retire les jours de congé liés à sa demande quand il l'annule
    match /planning/{docId} {
      allow write: if isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.addedByEmployee == true
                    && request.resource.data.addedByUid == request.auth.uid;
      allow delete: if isAuthenticated() && (
                       resource.data.get('addedByUid', '') == request.auth.uid
                    || (resource.data.get('id_leaveRequest', '') != ''
                        && get(/databases/$(database)/documents/leaveRequests/$(resource.data.id_leaveRequest)).data.userId == request.auth.uid));
    }

    // 7. SUIVI DES ERREURS
    match /errorLogs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 8. ADMINISTRATION (inchangé)
    match /chantiers/{docId} { allow write: if isAdmin(); }
    match /publishedSchedules/{docId} { allow write: if isAdmin(); }
    match /colleagues/{docId} { allow write: if isAdmin(); }
    match /notifications/{docId} { allow write: if isAdmin(); }
    match /counters/{docId} { allow write: if isAdmin(); }

    // 9. COLLÈGUES APPRÉCIÉS (planification automatique) : privé
    //    L'employé lit et modifie sa liste ; l'admin les lit toutes.
    match /affinites/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId)
                   && request.resource.data.keys().hasOnly(['like', 'updatedAt'])
                   && request.resource.data.like is list;
    }
  }
}
